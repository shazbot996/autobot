# cr2: local state, never shared
.cr2/transcript.json
.cr2/session.json
.cr2/local.json
.cr2/runs.jsonl*
.cr2/attachments/
.cr2/graph/*/
.cr2/story/
prompts/*/DRAFT.prompt.md
# cr2's cache (its clone of the skills repository)
.run/

# python
.venv/
.venv-server/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# autobot: runtime state (pid file, log, socket) and model files, never committed
run/
models/

# the owner's voice recordings: never committed, never leave the NUC
data/

# secrets
secrets/
.env
.env.*
*.pem
*.key
*credentials*.json
service-account*.json

# agent tools: per-machine settings
.claude/settings.local.json

# editors and the desktop
.vscode/
.idea/
*.swp
*~
.DS_Store

# the peer project `assistant` (CLAUDE.md): a separate project with its own
# secrets and a Home Assistant configuration. Never part of this repository.
assistant/
